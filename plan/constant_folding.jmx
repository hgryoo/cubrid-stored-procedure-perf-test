ALTER CLASS dummy add method class m_plus(int,int) int function m_t1 file &apos;$CUBRID/method/method.so&apos;, &apos;$CUBRID/lib/libcubridesql.so&apos;;

CREATE OR REPLACE FUNCTION j_hello() RETURN STRING AS LANGUAGE JAVA NAME &apos;SpPrepareTest.testHello() return java.lang.String&apos;;
CREATE OR REPLACE FUNCTION j_plus(a INT, b INT) RETURN int as language java name &apos;SpPrepareTest.testWithoutJDBC(int, int) return int&apos;;</stringProp>
